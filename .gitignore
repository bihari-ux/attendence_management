# Dependencies (very large folders - never commit)
node_modules/
*/node_modules/
**/node_modules/

# Environment Variables (keep your secrets safe)
.env
.env.local
.env.*.local
*/.env
*/.env.*.local
**/.env
**/.env.*.local
!.env.example
!*/.env.example

# Production & Build outputs
dist/
dist-ssr/
build/
client/dist/
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Metadata
.DS_Store
Thumbs.db
desktop.ini

# Temporary folders
tmp/
temp/
